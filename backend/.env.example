# ===== 主 LLM（DashScope Anthropic 兼容；亦可换 DeepSeek / OpenAI）=====
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen3-max

# ===== 备选 LLM（OpenAI 兼容：DeepSeek / DashScope OpenAI 兼容）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
PLAN_MODEL=deepseek-chat
RAG_MODEL=deepseek-chat
ANSWER_MODEL=deepseek-reasoner

# ===== OpenAI（Web Research 专用，可选）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ===== 服务监听 =====
# HOST 是**唯一真相**（P1-10）：`python -m app.main` 读它启动。
# 默认只监听回环（单机自用，安全默认）；需要对外提供服务时显式改为 0.0.0.0。
# 容器形态由 docker-compose.yml 显式覆盖为 0.0.0.0（容器内绑全网卡是对的，
# 对外入口由 Nginx 反代管控）。
HOST=127.0.0.1
PORT=18040

# ===== Web 形态最小鉴权（P1-01，可选）=====
# 留空 = 不启用（单机自用默认形态）；非空时 Web 形态的 /api/v1/** 需携带该 Key
# （X-API-Key 头 / Authorization: Bearer / ?api_key= 查询参数）。
# AGENT_API_KEY=
#
# ===== 执行预算 =====
EXEC_TIMEOUT=180
MAX_ITERATIONS=20

# ===== MCP 链路（可选）=====
SERPER_API_KEY=
GAODE_API_KEY=
MCP_MAX_SERVERS=5
MCP_CALL_TIMEOUT=60

# ===== RAG 链路 =====
MILVUS_DB_PATH=data/milvus.db
MILVUS_COLLECTION=hybrid_demo

# ===== Deep Research 链路（第 5 链）=====
# 检索引擎：BOCHA_API_KEY 优先；为空时自动降级到 SERPER_API_KEY；两者皆空则无法提交研究任务
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
BOCHA_DEFAULT_COUNT=10
BOCHA_SUMMARY=true

# Research Manager
RESEARCH_OUTPUT_DIR=data/research
RESEARCH_MAX_CONCURRENT=3
RESEARCH_PERSIST=true

# ===== 数据库（可选）=====
# 默认 SQLite（backend/data/app.db）；切 PostgreSQL 时给完整 URL：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent
DATABASE_URL=

# ===== 结构化日志落盘（可选）=====
# LOG_TO_FILE=true 时在 LOG_FILE_DIR 下写 JSON 行日志（RotatingFileHandler 自动轮转）。
LOG_TO_FILE=false
LOG_FILE_DIR=data/logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# 结构化日志采样率（0.0~1.0；1.0 = 全量）
LOG_SAMPLE_RATE=1.0

# ===== CORS（可选）=====
# 逗号分隔的**显式白名单**；留空 = 不返回 ["*"]（安全默认）。
# 例：CORS_ORIGINS=http://127.0.0.1:18040,http://localhost:18040
CORS_ORIGINS=

# ===== 桌面壳（可选，Electron 侧注入）=====
# AGENT_DESKTOP=1
# AGENT_DESKTOP_TOKEN=            # 壳侧生成的随机令牌（勿写入版本库）
# AGENT_DESKTOP_BOOTSTRAP_NONCE=  # 一次性引导 nonce
# AGENT_DESKTOP_PROTOCOL=1
# AGENT_DESKTOP_MISSED_WINDOW_HOURS=6   # 唤醒后补跑错过的定时任务的窗口（小时）

# ===== 容器 / compose（仅 docker-compose 使用）=====
# 对外发布端口的**绑定地址**：默认只绑回环（仅本机可达）。
# 需要局域网访问时设为 0.0.0.0 —— 此时**必须**配置 AGENT_API_KEY，
# 否则后端容器会**拒绝启动**（deploy/backend/entrypoint.sh 的暴露面校验）。
HOST_HTTP_BIND=127.0.0.1
HOST_HTTP_PORT=8080
# 国内镜像加速（构建期）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# APT_MIRROR=mirrors.ustc.edu.cn
