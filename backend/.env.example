# ===== 主 LLM（DashScope Anthropic 兼容；亦可换 DeepSeek / OpenAI）=====
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen3-max

# ===== 备选 LLM（OpenAI 兼容：DeepSeek / DashScope OpenAI 兼容）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
PLAN_MODEL=deepseek-chat
RAG_MODEL=deepseek-chat
ANSWER_MODEL=deepseek-reasoner

# ===== OpenAI（Web Research 专用，可选）=====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=8000
EXEC_TIMEOUT=180
MAX_ITERATIONS=20

# ===== MCP 链路（可选）=====
SERPER_API_KEY=
GAODE_API_KEY=
MCP_MAX_SERVERS=5
MCP_CALL_TIMEOUT=60

# ===== RAG 链路 =====
MILVUS_DB_PATH=data/milvus.db
MILVUS_COLLECTION=hybrid_demo

# ===== Deep Research 链路（第 5 链）=====
# 检索引擎：BOCHA_API_KEY 优先；为空时自动降级到 SERPER_API_KEY；两者皆空则无法提交研究任务
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
BOCHA_DEFAULT_COUNT=10
BOCHA_SUMMARY=true

# Research Manager
RESEARCH_OUTPUT_DIR=data/research
RESEARCH_MAX_CONCURRENT=3
RESEARCH_PERSIST=true
